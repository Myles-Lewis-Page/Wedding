generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WeddingSettings {
  id              String   @id @default(cuid())
  brideName       String   @default("Jennifer")
  groomName       String   @default("Myles")
  weddingDate     String   @default("")
  selectedVenueId String?
  dressCode       String   @default("Garden Formal")
  ourStory        String   @default("")
  ceremonyTime    String   @default("4:00 PM")
  receptionTime   String   @default("6:00 PM")
  createdAt       DateTime @default(now())
  @@map("wedding_settings")
}

model Venue {
  id          String   @id @default(cuid())
  name        String
  url         String   @default("")
  imageUrl    String   @default("")
  cost        Float    @default(0)
  address     String   @default("")
  description String   @default("")
  capacity    Int?
  phone       String   @default("")
  email       String   @default("")
  website     String   @default("")
  amenities   String[] @default([])
  isSelected  Boolean  @default(false)
  notes       String   @default("")
  createdAt   DateTime @default(now())
  @@map("venues")
}

model Guest {
  id             String    @id @default(cuid())
  name           String
  email          String?
  side           String    @default("bride")
  hasPlusOne     Boolean   @default(false)
  plusOneName    String?
  plusOneDietary String?
  dietary        String?
  rsvpStatus     String    @default("pending")
  tableId        String?
  seatNumber     Int?
  rsvpAt         DateTime?
  notes          String?
  address        String?   @default("")
  partyRole      String?   @default("")
  isInvitee      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  @@map("guests")
}

model SeatingTable {
  id        String   @id @default(cuid())
  name      String
  shape     String   @default("round")
  seats     Int      @default(8)
  x         Float    @default(100)
  y         Float    @default(100)
  color     String   @default("#E1F5EE")
  createdAt DateTime @default(now())
  @@map("seating_tables")
}

model BudgetCategory {
  id       String @id @default(cuid())
  name     String
  budgeted Float  @default(0)
  paid     Float  @default(0)
  color    String @default("#8FAF7A")
  order    Int    @default(0)
  @@map("budget_categories")
}

model Vendor {
  id          String   @id @default(cuid())
  category    String   @default("Other")
  name        String
  contactName String   @default("")
  phone       String   @default("")
  email       String   @default("")
  website     String   @default("")
  cost        Float    @default(0)
  paid        Float    @default(0)
  status      String   @default("researching")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  @@map("vendors")
}

model Task {
  id         String    @id @default(cuid())
  title      String
  category   String    @default("General")
  dueDate    DateTime?
  priority   String    @default("medium")
  completed  Boolean   @default(false)
  assignedTo String    @default("Both")
  createdAt  DateTime  @default(now())
  @@map("tasks")
}

model Gift {
  id           String    @id @default(cuid())
  fromName     String
  description  String    @default("")
  value        Float?
  thankYouSent Boolean   @default(false)
  receivedAt   DateTime?
  createdAt    DateTime  @default(now())
  @@map("gifts")
}

model RsvpSettings {
  id               String @id @default("main")
  brideName        String @default("")
  groomName        String @default("")
  heading          String @default("Our Wedding") @map("heading")
  subheading       String @default("Join us as we celebrate our wedding day")
  dateText         String @default("") @map("date_text")
  venueText        String @default("") @map("venue_text")
  heroImage        String @default("") @map("hero_image")
  photo1           String @default("")
  photo2           String @default("")
  photo3           String @default("")
  accentColor      String @default("#4a7a44")
  secondaryColor   String @default("#8fb882")
  bgColor          String @default("#111714")
  tertiaryColor    String @default("#1a2419")
  titleColor       String @default("#ffffff")
  subheaderColor   String @default("#000000")
  bodyColor        String @default("#9ca3af")
  swatchBridesmaids String @default("#9bb89a")
  swatchSuits      String @default("#4a5568")
  swatchVenue      String @default("#8b7355")
  swatchFlowers    String @default("#e8b4bc")
  searchLabel      String @default("Enter your name as it appears on your invitation") @map("search_label")
  attendingLabel   String @default("Yes, I'll be there!") @map("attending_label")
  declineLabel     String @default("Regretfully no") @map("decline_label")
  confirmedMessage String @default("We can't wait to celebrate with you!") @map("confirmed_message")
  declinedMessage  String @default("Thank you for letting us know. We'll be thinking of you!") @map("declined_message")
  contactEmail     String @default("") @map("contact_email")
  weddingDate      String @default("") @map("wedding_date")
  @@map("rsvp_settings")
}

model TimelineItem {
  id    String @id @default(cuid())
  time  String @default("")
  title String
  desc  String @default("")
  who   String @default("")
  order Int    @default(0)
  @@map("timeline_items")
}
